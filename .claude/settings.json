{
  "$schema": "https://json.schemastore.org/claude-code-settings.json",
  "permissions": {
    "allow": [
      "Bash(npm run lint:*)",
      "Bash(npm run typecheck)",
      "Bash(npm run build)",
      "Bash(npm run test:*)",
      "Bash(npm test:*)",
      "Bash(npx vitest:*)",
      "Bash(npx playwright test:*)",
      "Bash(npx tsc --noEmit:*)",
      "Bash(npx eslint:*)",
      "Bash(git status:*)",
      "Bash(git diff:*)",
      "Bash(git log:*)",
      "Bash(git show:*)",
      "Bash(git branch:*)",
      "Bash(gh pr view:*)",
      "Bash(gh pr list:*)",
      "Bash(gh run view:*)",
      "Bash(gh run list:*)",
      "Bash(jq:*)",
      "Bash(terraform fmt:*)",
      "Bash(terraform validate:*)",
      "Bash(terraform plan:*)",
      "Bash(aws dynamodb * --endpoint-url http://localhost:8000:*)",
      "Bash(aws dynamodb describe-table:*)",
      "Bash(aws dynamodb list-tables:*)",
      "Bash(aws sts get-caller-identity:*)",
      "Bash(render services:*)",
      "Bash(render deploys list:*)",
      "Bash(render logs:*)",
      "WebFetch(domain:db.ygoprodeck.com)",
      "WebFetch(domain:ygoprodeck.com)",
      "WebFetch(domain:authjs.dev)",
      "WebFetch(domain:ui.shadcn.com)",
      "WebFetch(domain:docs.aws.amazon.com)",
      "WebFetch(domain:render.com)",
      "WebFetch(domain:registry.terraform.io)",
      "Bash(render blueprints validate:*)",
      "Bash(render skills list:*)",
      "Bash(cdk --version)"
    ],
    "ask": [
      "Bash(terraform apply:*)",
      "Bash(terraform destroy:*)",
      "Bash(terraform import:*)",
      "Bash(terraform state:*)",
      "Bash(aws dynamodb delete-table:*)",
      "Bash(aws iam:*)",
      "Bash(render deploys create:*)",
      "Bash(gh secret:*)",
      "Bash(git push:*)"
    ],
    "deny": [
      "Read(./.env)",
      "Read(./.env.*)",
      "Read(**/*.tfstate)",
      "Read(**/*.tfvars)",
      "Read(~/.aws/credentials)"
    ]
  },
  "hooks": {
    "PostToolUse": [
      {
        "matcher": "Edit|Write|MultiEdit",
        "hooks": [
          {
            "type": "command",
            "command": "\"$CLAUDE_PROJECT_DIR\"/.claude/hooks/lint-edited-file.sh",
            "timeout": 60
          }
        ]
      }
    ]
  }
}
