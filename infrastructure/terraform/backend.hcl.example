# Copy to backend.hcl (gitignored) and fill in the values from
# `terraform output` in infrastructure/bootstrap, then run:
#   terraform init -backend-config=backend.hcl
bucket       = "yugioh-collection-tfstate-<account_id>"
key          = "yugioh-collection/terraform.tfstate"
region       = "eu-central-1"
encrypt      = true
use_lockfile = true
