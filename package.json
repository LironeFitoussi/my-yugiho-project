{
  "name": "my-yugiho-project",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "eslint",
    "typecheck": "tsc --noEmit",
    "db:local": "mkdir -p .dynamodb && java -Djava.library.path=$HOME/.dynamodb-local/DynamoDBLocal_lib -jar $HOME/.dynamodb-local/DynamoDBLocal.jar -sharedDb -dbPath .dynamodb -port 8000",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:e2e": "playwright test",
    "db:create-local": "node --env-file-if-exists=.env.local scripts/create-local-table.ts"
  },
  "dependencies": {
    "@aws-sdk/client-dynamodb": "^3.1153.0",
    "@aws-sdk/lib-dynamodb": "^3.1153.0",
    "@base-ui/react": "^1.9.0",
    "class-variance-authority": "^0.7.1",
    "cn": "^0.5.0",
    "decimal.js": "^10.6.0",
    "lucide-react": "^1.60.0",
    "next": "16.4.2",
    "next-auth": "^5.0.0-beta.32",
    "next-themes": "^0.4.6",
    "react": "19.3.0",
    "react-dom": "19.3.0",
    "server-only": "^0.0.1",
    "shadcn": "^4.22.1",
    "sonner": "^2.0.8",
    "tw-animate-css": "^1.4.0",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@playwright/test": "^1.64.1",
    "@tailwindcss/turbopack": "^4",
    "@types/node": "^24.19.2",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "@vitejs/plugin-react": "^6.1.2",
    "eslint": "^9",
    "eslint-config-next": "16.4.2",
    "tailwindcss": "^4",
    "typescript": "^5",
    "vite-tsconfig-paths": "^6.1.1",
    "vitest": "^5.0.5"
  }
}
